<Window x:Class="MacExtendClient.StreamDumpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacExtend Client — Fase 3a (dump a archivo)"
        Height="220" Width="480"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="MacExtend Client — Fase 3a (dump a archivo)" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock x:Name="StatusText" Text="Conectando…" FontFamily="Consolas" TextWrapping="Wrap"/>
        <Button x:Name="StopButton" Content="Stop" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="16,4" Click="OnStopClicked"/>
    </StackPanel>
</Window>
